{
  "name": "uptime-health",
  "version": "1.0.0",
  "description": "A fancy, lightweight, self-hosted system health check & uptime monitoring tool",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
